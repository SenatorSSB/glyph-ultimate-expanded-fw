{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glyph Agent Model Routing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "roles",
    "dispatch_policy",
    "lanes",
    "worker_roster_policy"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "default_model",
          "default_reasoning_effort",
          "escalation_model",
          "escalation_reasoning_effort",
          "escalation_triggers",
          "deescalation_triggers",
          "output_contract",
          "tool_permission_posture",
          "default_lane"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "default_model": {
            "type": "string"
          },
          "default_reasoning_effort": {
            "type": "string"
          },
          "escalation_model": {
            "type": "string"
          },
          "escalation_reasoning_effort": {
            "type": "string"
          },
          "escalation_triggers": {
            "type": "string"
          },
          "deescalation_triggers": {
            "type": "string"
          },
          "output_contract": {
            "type": "string"
          },
          "tool_permission_posture": {
            "type": "string"
          },
          "default_lane": {
            "enum": [
              "chapter_daemon",
              "mechanical",
              "established_implementation",
              "coupled_technical",
              "ambiguous",
              "exceptional"
            ]
          }
        }
      }
    },
    "dispatch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_model_effort_on_dispatch_and_resume",
        "record_requested_and_observed_execution",
        "unknown_telemetry_is_not_zero",
        "independence_separate_from_strength",
        "no_silent_unavailable_model_substitution",
        "chapter_daemon_unavailable_fallback",
        "exceptional_session"
      ],
      "properties": {
        "explicit_model_effort_on_dispatch_and_resume": {
          "const": true
        },
        "record_requested_and_observed_execution": {
          "const": true
        },
        "unknown_telemetry_is_not_zero": {
          "const": true
        },
        "independence_separate_from_strength": {
          "const": true
        },
        "no_silent_unavailable_model_substitution": {
          "const": true
        },
        "chapter_daemon_unavailable_fallback": {
          "type": "string",
          "minLength": 1
        },
        "exceptional_session": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_daemon",
        "mechanical",
        "established_implementation",
        "coupled_technical",
        "ambiguous",
        "exceptional"
      ],
      "properties": {
        "chapter_daemon": {
          "$ref": "#/$defs/task_lane"
        },
        "mechanical": {
          "$ref": "#/$defs/task_lane"
        },
        "established_implementation": {
          "$ref": "#/$defs/task_lane"
        },
        "coupled_technical": {
          "$ref": "#/$defs/task_lane"
        },
        "ambiguous": {
          "$ref": "#/$defs/task_lane"
        },
        "exceptional": {
          "$ref": "#/$defs/task_lane"
        }
      }
    },
    "worker_roster_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optional",
        "chapter_scoped",
        "expires_with_chapter",
        "requested_is_observed_proof",
        "owner_selected_is_runtime_observed",
        "unknown_observed_execution_allowed",
        "additional_visible_worker_requires_owner_authorization",
        "direct_return_grants_action_authority",
        "transport_failure_is_product_failure",
        "standing_polling_default",
        "watchdog_default",
        "watchdog_requires_demonstrated_callback_failure_and_inadequate_durable_recovery",
        "recovery_order",
        "capability_states"
      ],
      "properties": {
        "optional": {
          "const": true
        },
        "chapter_scoped": {
          "const": true
        },
        "expires_with_chapter": {
          "const": true
        },
        "requested_is_observed_proof": {
          "const": false
        },
        "owner_selected_is_runtime_observed": {
          "const": false
        },
        "unknown_observed_execution_allowed": {
          "const": true
        },
        "additional_visible_worker_requires_owner_authorization": {
          "const": true
        },
        "direct_return_grants_action_authority": {
          "const": false
        },
        "transport_failure_is_product_failure": {
          "const": false
        },
        "standing_polling_default": {
          "const": false
        },
        "watchdog_default": {
          "const": false
        },
        "watchdog_requires_demonstrated_callback_failure_and_inadequate_durable_recovery": {
          "const": true
        },
        "recovery_order": {
          "const": [
            "direct_completion_or_return",
            "one_bounded_resume_status",
            "durable_repository_result",
            "conditional_bounded_watchdog"
          ]
        },
        "capability_states": {
          "const": [
            "VERIFIED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        }
      }
    }
  },
  "$defs": {
    "task_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_family",
        "default_reasoning_effort",
        "escalation_reasoning_effort",
        "escalation_triggers",
        "deescalation_triggers"
      ],
      "properties": {
        "preferred_family": {
          "type": "string",
          "minLength": 1
        },
        "default_reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "escalation_reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "escalation_triggers": {
          "type": "string",
          "minLength": 1
        },
        "deescalation_triggers": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
