{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glyph Agent Model Routing",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "roles"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "openai_codex_default",
          "openai_reasoning_effort",
          "claude_default",
          "claude_effort",
          "escalation_trigger",
          "de_escalation_trigger",
          "output_contract",
          "tool_permission_posture"
        ],
        "properties": {
          "openai_codex_default": { "type": "string" },
          "openai_reasoning_effort": { "type": "string" },
          "claude_default": { "type": "string" },
          "claude_effort": { "type": "string" },
          "escalation_trigger": { "type": "string" },
          "de_escalation_trigger": { "type": "string" },
          "output_contract": { "type": "string" },
          "tool_permission_posture": { "type": "string" }
        }
      }
    }
  }
}
