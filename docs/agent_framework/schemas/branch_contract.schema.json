{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glyph Agent Branch Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch",
    "base_branch",
    "classification",
    "objective",
    "allowed_files",
    "forbidden_files",
    "active_behavior_constraints",
    "verification_required",
    "hardware_required",
    "stop_conditions"
  ],
  "properties": {
    "branch": { "type": "string", "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "string",
      "enum": [
        "DOCS_CHECKER_ONLY",
        "INACTIVE_GENERATOR_OR_FIXTURE",
        "FIRMWARE_SOURCE_NON_ACTIVE",
        "FIRMWARE_SOURCE_ACTIVE_BEHAVIOR",
        "FORBIDDEN_OR_UNSAFE"
      ]
    },
    "objective": { "type": "string", "minLength": 1 },
    "allowed_files": { "type": "array", "items": { "type": "string" } },
    "forbidden_files": { "type": "array", "items": { "type": "string" } },
    "active_behavior_constraints": { "type": "array", "items": { "type": "string" } },
    "verification_required": { "type": "array", "items": { "type": "string" } },
    "hardware_required": { "type": "boolean" },
    "stop_conditions": { "type": "array", "items": { "type": "string" } }
  }
}
