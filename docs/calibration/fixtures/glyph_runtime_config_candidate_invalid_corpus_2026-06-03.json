{
  "schema_name": "glyph_runtime_config_candidate_invalid_corpus",
  "corpus_version": 1,
  "status": "negative_validator_corpus",
  "hardware_status": "not_new_hardware_result",
  "validator_tool": "tools/glyph_runtime_config_candidate_validator.py",
  "baseline_fixture": "docs/calibration/fixtures/glyph_runtime_config_candidate_SAMPLE_2026-06-03.json",
  "cases": [
    {
      "case_id": "unknown_schema_name",
      "mutation": "replace the schema name with an unknown value",
      "expected_error_codes": ["E_INVALID_SCHEMA_NAME"],
      "payload": [
        {
          "op": "set",
          "path": ["schema_name"],
          "value": "glyph_runtime_config_candidate_unknown"
        }
      ]
    },
    {
      "case_id": "wrong_candidate_version",
      "mutation": "replace the candidate version with a non-matching value",
      "expected_error_codes": ["E_INVALID_CANDIDATE_VERSION"],
      "payload": [
        {
          "op": "set",
          "path": ["candidate_version"],
          "value": 2
        }
      ]
    },
    {
      "case_id": "unknown_mode_scope",
      "mutation": "replace the mode scope with an unsupported scope",
      "expected_error_codes": ["E_INVALID_MODE_SCOPE"],
      "payload": [
        {
          "op": "set",
          "path": ["mode_scope"],
          "value": "MODE_UNKNOWN"
        }
      ]
    },
    {
